<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Session recovery state is temporary and must not be restored after reinstall. -->
        <exclude domain="file" path="flowforge-session-cache.json" />
        <exclude domain="file" path="flowforge-session-cache.tmp" />
    </cloud-backup>
    <device-transfer>
        <!-- Session recovery state is temporary and must not be transferred to a fresh install. -->
        <exclude domain="file" path="flowforge-session-cache.json" />
        <exclude domain="file" path="flowforge-session-cache.tmp" />
    </device-transfer>
</data-extraction-rules>
